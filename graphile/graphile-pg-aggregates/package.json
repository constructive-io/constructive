  },
  "dependencies": {
    "graphile-plugin-utils": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "graphile-connection-filter": "workspace:^",
    "graphile-test": "workspace:^",
    "makage": "^0.8.0",
    "pgsql-test": "workspace:^"
  },
  "peerDependencies": {
    "@dataplan/pg": "^1.1.1",
    "grafast": "^1.1.1",
    "graphile-build": "^5.1.1",
    "graphile-build-pg": "^5.1.3",
    "graphile-config": "^1.1.0",
    "graphile-connection-filter": "^2.11.3",
    "graphql": "^16.9.0",
    "pg-sql2": "^5.0.1",
    "postgraphile": "^5.1.3"
  }
