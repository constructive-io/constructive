{
  "name": "constructive",
  "version": "2.0.0",
  "author": "Constructive <developers@constructive.io>",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/constructive-io/constructive"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "pnpm -r run clean",
    "build": "pnpm -r run build",
    "build:dev": "pnpm -r run build:dev",
    "lint": "pnpm -r run lint",
    "internal:deps": "makage update-workspace",
    "deps": "pnpm up -r -i -L",
    "fixtures:install": "node pgpm/cli/dist/index.js install -W",
    "fixtures:install:force": "node pgpm/cli/dist/index.js install -W --force",
    "policy": "pnpm-policy generate",
    "policy:check": "pnpm-policy check"
  },
  "devDependencies": {
    "@constructive-io/eslint-config": "^0.2.0",
    "@constructive-io/pnpm-policy": "0.3.1",
    "@constructive-io/pnpm-policy-graphile": "0.2.0",
    "@jest/test-sequencer": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/jest-in-case": "^1.0.9",
    "@types/node": "^22.19.11",
    "@types/pg": "^8.20.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.4.2",
    "jest-in-case": "^1.0.2",
    "lerna": "^8.2.3",
    "makage": "^0.3.0",
    "pnpm-policy": "^0.4.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.6"
  },
  "overrides": {
    "graphql": "^16.9.0"
  },
  "pnpm": {
    "overrides": {
      "grafast": "1.1.1",
      "grafserv": "1.0.1",
      "graphile-build": "5.1.1",
      "graphile-build-pg": "5.1.3",
      "graphile-config": "1.1.0",
      "graphile-utils": "5.0.3",
      "postgraphile": "5.1.3",
      "pg-sql2": "5.0.1",
      "pg-introspection": "1.0.1",
      "tamedevil": "0.1.1",
      "@dataplan/pg": "1.1.1",
      "@dataplan/json": "1.0.1",
      "@graphile/lru": "5.0.0",
      "@graphile-contrib/pg-many-to-many": "2.0.0-rc.2",
      "graphql": "16.13.0",
      "@smithy/node-http-handler": "<4.5.0"
    },
    "publicHoistPattern": [
      "@jest/test-sequencer"
    ],
    "packageExtensions": {
      "jest-config@*": {
        "dependencies": {
          "@jest/test-sequencer": "^29.7.0"
        }
      }
    },
    "onlyBuiltDependencies": [
      "@launchql/protobufjs",
      "core-js-pure"
    ]
  }
}
