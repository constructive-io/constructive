{
  "name": "pg-codegen",
  "version": "5.22.0",
  "author": "Constructive <developers@constructive.io>",
  "description": "Type-safe TypeScript codegen from live PostgreSQL schemas: row types, coerce-backed decoders, serializers, table metadata, and enum unions",
  "main": "index.js",
  "bin": {
    "pg-codegen": "cli.js"
  },
  "module": "esm/index.js",
  "types": "index.d.ts",
  "homepage": "https://github.com/constructive-io/constructive",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/constructive-io/constructive"
  },
  "bugs": {
    "url": "https://github.com/constructive-io/constructive/issues"
  },
  "scripts": {
    "clean": "makage clean",
    "copy": "makage assets",
    "prepack": "npm run build",
    "copy:templates": "mkdir -p dist/emit/templates dist/esm/emit/templates && cp src/emit/templates/*.ts dist/emit/templates/ && cp src/emit/templates/*.ts dist/esm/emit/templates/",
    "build": "makage build && npm run copy:templates",
    "build:dev": "makage build --dev && npm run copy:templates",
    "dev": "ts-node ./src/cli.ts",
    "lint": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "codegen",
    "PostgreSQL",
    "typescript",
    "pg",
    "constructive",
    "generator"
  ],
  "dependencies": {
    "@babel/generator": "^7.29.1",
    "@babel/types": "^7.29.0",
    "@constructive-io/coerce": "workspace:^",
    "@constructive-io/query-builder": "workspace:^",
    "inflekt": "^0.8.1",
    "introspectron": "workspace:^",
    "pg": "^8.21.0",
    "pg-env": "workspace:^"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.6.8",
    "@types/pg": "^8.20.4",
    "makage": "^0.3.0",
    "pgsql-test": "workspace:^"
  }
}
