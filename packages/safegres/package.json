{
  "name": "safegres",
  "version": "1.25.1",
  "author": "Constructive <developers@constructive.io>",
  "description": "Postgres security and performance auditor: RLS, grants and effective-access analysis plus index and policy-cost checks, scored on two independent axes. One connection, no framework.",
  "main": "index.js",
  "module": "esm/index.js",
  "types": "index.d.ts",
  "homepage": "https://github.com/constructive-io/constructive",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/constructive-io/constructive"
  },
  "bugs": {
    "url": "https://github.com/constructive-io/constructive/issues"
  },
  "bin": {
    "safegres": "cli.js"
  },
  "scripts": {
    "clean": "makage clean",
    "prepack": "npm run build",
    "build": "makage build && chmod +x dist/cli.js && mkdir -p dist/corpus dist/schema && cp -r corpus/. dist/corpus/ && cp schema/*.json dist/schema/",
    "build:dev": "makage build --dev && chmod +x dist/cli.js && mkdir -p dist/corpus dist/schema && cp -r corpus/. dist/corpus/ && cp schema/*.json dist/schema/",
    "schema": "npm run build:dev && node scripts/write-schema.js",
    "lint": "eslint . --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "database",
    "security",
    "performance",
    "rls",
    "row-level-security",
    "audit",
    "auditor",
    "linter",
    "static-analysis",
    "index",
    "indexing",
    "query-performance",
    "explain",
    "grants",
    "policy",
    "sarif",
    "ci",
    "devsecops",
    "dba",
    "safegres"
  ],
  "dependencies": {
    "@inquirerer/utils": "^3.3.13",
    "@pgpmjs/logger": "workspace:^",
    "@pgsql/lint": "^18.2.5",
    "@pgsql/traverse": "^18.7.7",
    "@pgsql/types": "^18.0.0",
    "confstash": "^0.1.2",
    "inquirerer": "^4.9.4",
    "libpg-query": "^18.1.4",
    "pg": "^8.21.0",
    "pg-env": "workspace:^",
    "pgsql-deparser": "^18.3.6",
    "pgsql-parser": "^18.2.6",
    "yanse": "^0.2.2"
  },
  "peerDependencies": {
    "pgsql-test": "*"
  },
  "peerDependenciesMeta": {
    "pgsql-test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.4",
    "makage": "^0.8.0",
    "pgsql-test": "workspace:^"
  }
}
