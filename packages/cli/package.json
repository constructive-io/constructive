{
  "name": "@constructive-io/cli",
  "version": "8.17.0",
  "author": "Constructive <developers@constructive.io>",
  "description": "Constructive CLI",
  "main": "index.js",
  "module": "esm/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./esm/index.js",
      "require": "./index.js"
    },
    "./runtime": {
      "types": "./runtime/index.d.ts",
      "import": "./esm/runtime/index.js",
      "require": "./runtime/index.js"
    },
    "./config": {
      "types": "./config/index.d.ts",
      "import": "./esm/config/index.js",
      "require": "./config/index.js"
    },
    "./sdk": {
      "types": "./sdk/index.d.ts",
      "import": "./esm/sdk/index.js",
      "require": "./sdk/index.js"
    },
    "./utils": {
      "types": "./utils/index.d.ts",
      "import": "./esm/utils/index.js",
      "require": "./utils/index.js"
    },
    "./*.js": {
      "types": "./*.d.ts",
      "import": "./esm/*.js",
      "require": "./*.js"
    },
    "./*": {
      "types": "./*.d.ts",
      "import": "./esm/*.js",
      "require": "./*.js"
    },
    "./package.json": "./package.json"
  },
  "homepage": "https://github.com/constructive-io/constructive",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "bin": {
    "cnc": "index.js",
    "constructive": "index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/constructive-io/constructive"
  },
  "bugs": {
    "url": "https://github.com/constructive-io/constructive/issues"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "clean": "makage clean",
    "prepack": "npm run build",
    "build": "makage build && node ./scripts/finalize-esm.js",
    "build:dev": "makage build --dev && node ./scripts/finalize-esm.js",
    "dev": "ts-node ./src/index.ts",
    "lint": "eslint . --fix",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@inquirerer/test": "^1.4.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.11",
    "@types/pg": "^8.20.4",
    "@types/shelljs": "^0.10.0",
    "glob": "^13.0.6",
    "makage": "^0.3.0",
    "pg": "^8.21.0",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@constructive-io/cli-runtime": "workspace:^",
    "@inquirerer/utils": "^3.3.12",
    "@pgpmjs/logger": "workspace:^",
    "@sinclair/typebox": "^0.34.49",
    "appstash": "^0.8.0",
    "find-and-require-package-json": "^0.9.1",
    "graphql": "16.13.0",
    "inquirerer": "^4.9.3",
    "js-yaml": "^4.1.0",
    "shelljs": "^0.10.0",
    "yanse": "^0.2.2"
  },
  "optionalDependencies": {
    "@constructive-io/graphql-codegen": "workspace:^",
    "@constructive-io/graphql-env": "workspace:^",
    "@constructive-io/graphql-explorer": "workspace:^",
    "@constructive-io/graphql-server": "workspace:^",
    "@constructive-io/graphql-types": "workspace:^",
    "@pgpmjs/core": "workspace:^",
    "@pgpmjs/server-utils": "workspace:^",
    "@pgpmjs/types": "workspace:^",
    "pg-cache": "workspace:^",
    "pg-env": "workspace:^",
    "pgpm": "workspace:^"
  },
  "keywords": [
    "cli",
    "command-line",
    "tool",
    "constructive",
    "utilities",
    "pg",
    "pgsql",
    "postgres",
    "graphile"
  ],
  "gitHead": "05d1197d6ff6e4c30afd0b8514427b612c5bc1e1"
}
