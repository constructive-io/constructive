{
  "name": "@constructive-io/graphql-dev-server",
  "version": "3.11.4",
  "author": "Constructive <developers@constructive.io>",
  "description": "Pure-PostGraphile single-tenant dev server (no scoped routing, no database-id plugins)",
  "main": "index.js",
  "module": "esm/index.js",
  "types": "index.d.ts",
  "homepage": "https://github.com/constructive-io/constructive",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/constructive-io/constructive"
  },
  "bugs": {
    "url": "https://github.com/constructive-io/constructive/issues"
  },
  "scripts": {
    "clean": "makage clean",
    "prepack": "npm run build",
    "build": "makage build",
    "build:dev": "makage build --dev",
    "lint": "eslint . --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.20.0",
    "makage": "^0.3.0"
  },
  "dependencies": {
    "@constructive-io/graphql-env": "workspace:^",
    "@constructive-io/graphql-types": "workspace:^",
    "@pgpmjs/logger": "workspace:^",
    "@pgpmjs/server-utils": "workspace:^",
    "express": "^5.2.1",
    "grafast": "1.0.2",
    "grafserv": "1.0.0",
    "graphile-build": "5.0.2",
    "graphile-build-pg": "5.0.2",
    "graphile-cache": "workspace:^",
    "graphile-config": "1.0.1",
    "graphile-settings": "workspace:^",
    "graphile-utils": "5.0.1",
    "graphql": "16.13.0",
    "pg": "^8.21.0",
    "pg-cache": "workspace:^",
    "pg-env": "workspace:^",
    "pg-sql2": "5.0.1",
    "postgraphile": "5.0.3"
  },
  "keywords": [
    "graphql",
    "graphile",
    "postgraphile",
    "constructive",
    "dev-server",
    "single-tenant"
  ]
}
