    {
      "table_name": "attachments",
      "description": "Generic file attachment on any CRM record: record_type names the table (contacts, companies, deals, interactions, notes, ...) and record_id the row. file is an attachment reference into the private org attachments bucket; text-like files are extracted and embedded so the org agent can retrieve them.",
      "nodes": [
        "DataId",
        "DataTimestamps",
        {
          "$type": "DataOwnershipInEntity",
          "data": {
            "entity_field": "entity_id"
          }
        },
        {
          "$type": "DataFileRef",
          "data": {
            "field": "file",
            "storage": {
              "scope": "org"
            },
            "bucket": "attachments"
          }
        },
        {
          "$type": "ProcessExtraction",
          "data": {
            "file_field": "file",
            "events": [
              "INSERT",
              "UPDATE"
            ],
            "mime_patterns": [
              "application/pdf",
              "text/%",
              "application/json",
              "application/msword",
              "application/vnd.openxmlformats-officedocument.%",
              "application/vnd.ms-excel",
              "application/vnd.ms-powerpoint"
            ]
          }
        },
        {
          "$type": "SearchUnified",
          "data": {
            "full_text_search": {
              "field_name": "search_tsv",
              "source_fields": [
                {
                  "field": "title",
                  "weight": "A"
                },
                {
                  "field": "description",
                  "weight": "B"
                },
                {
                  "field": "extracted_text",
                  "weight": "C"
                }
              ]
            },
            "trgm_fields": [
              "title"
            ],
            "source_fields": [
              "title",
              "description",
              "extracted_text"
            ],
            "embedding": {
              "field_name": "embedding",
              "chunks": {
                "chunk_size": 1000,
                "chunk_overlap": 200,
                "chunk_strategy": "paragraph"
              }
            }
          }
        }
      ],
      "fields": [
        {
          "name": "record_type",
          "type": {
            "name": "text"
          },
          "is_required": true
        },
        {
          "name": "record_id",
          "type": {
            "name": "uuid"
          },
          "is_required": true
        },
        {
          "name": "title",
          "type": {
            "name": "text"
          }
        },
        {
          "name": "description",
          "type": {
            "name": "text"
          }
        },
        {
          "name": "file",
          "type": {
            "name": "upload"
          },
          "is_required": true,
          "description": "Projection of an org_files row in the private attachments bucket."
        }
      ],
      "grants": [
        {
          "roles": [
            "authenticated"
          ],
          "privileges": [
            [
              "select",
              "*"
            ],
            [
              "insert",
              "*"
            ],
            [
              "update",
              "*"
            ],
            [
              "delete",
              "*"
            ]
          ]
        }
      ],
      "use_rls": true,
      "policies": [
        {
          "$type": "AuthzEntityMembership",
          "privileges": [
            "select",
            "insert",
            "update",
            "delete"
          ],
          "data": {
            "entity_field": "entity_id",
            "entity_type": "org"
          },
          "permissive": true
        }
      ],
      "indexes": [
        {
          "columns": [
            "record_type",
            "record_id"
          ],
          "access_method": "btree"
        }
      ]
    },
