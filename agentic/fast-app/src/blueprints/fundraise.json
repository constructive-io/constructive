    {
      "table_name": "deals",
      "description": "A pipeline item (e.g. an investor conversation). stage is free text so pipelines can be renamed without migration.",
      "nodes": [
        "DataId",
        "DataTimestamps",
        {
          "$type": "DataOwnershipInEntity",
          "data": {
            "entity_field": "entity_id"
          }
        },
        {
          "$type": "DataStatusField",
          "data": {
            "field_name": "stage",
            "default_value": {
              "value": "lead"
            },
            "allowed_values": [
              "lead",
              "contacted",
              "meeting",
              "diligence",
              "term_sheet",
              "committed",
              "closed",
              "passed"
            ]
          }
        },
        {
          "$type": "SearchUnified",
          "data": {
            "full_text_search": {
              "field_name": "search_tsv",
              "source_fields": [
                {
                  "field": "name",
                  "weight": "A"
                },
                {
                  "field": "notes_text",
                  "weight": "B"
                }
              ]
            },
            "trgm_fields": [
              "name"
            ],
            "source_fields": [
              "name",
              "notes_text"
            ],
            "embedding": {
              "field_name": "embedding",
              "chunks": {
                "chunk_size": 1000,
                "chunk_overlap": 200,
                "chunk_strategy": "paragraph"
              }
            }
          }
        }
      ],
      "fields": [
        {
          "name": "name",
          "type": {
            "name": "text"
          },
          "is_required": true
        },
        {
          "name": "value",
          "type": {
            "name": "numeric"
          }
        },
        {
          "name": "currency",
          "type": {
            "name": "text"
          },
          "is_required": true,
          "default": {
            "value": "USD"
          }
        },
        {
          "name": "expected_close_date",
          "type": {
            "name": "date"
          }
        },
        {
          "name": "notes_text",
          "type": {
            "name": "text"
          }
        },
        {
          "name": "data_room_id",
          "type": {
            "name": "uuid"
          },
          "description": "The Data Room shared with this investor. A pointer only: it grants no access to the room or its files - the investor must be added as a room member."
        }
      ],
      "grants": [
        {
          "roles": [
            "authenticated"
          ],
          "privileges": [
            [
              "select",
              "*"
            ],
            [
              "insert",
              "*"
            ],
            [
              "update",
              "*"
            ],
            [
              "delete",
              "*"
            ]
          ]
        }
      ],
      "use_rls": true,
      "policies": [
        {
          "$type": "AuthzEntityMembership",
          "privileges": [
            "select",
            "insert",
            "update",
            "delete"
          ],
          "data": {
            "entity_field": "entity_id",
            "entity_type": "org"
          },
          "permissive": true
        }
      ],
      "indexes": [
        {
          "column": "data_room_id",
          "access_method": "btree"
        }
      ]
    },
