  "entity_types": [
    {
      "name": "Data Room",
      "prefix": "data_room",
      "description": "A private document room owned by an org. Only direct members can see the room or its files.",
      "parent_entity": "org",
      "is_visible": false,
      "has_limits": true,
      "has_profiles": true,
      "has_invites": true,
      "storage": [
        {
          "key": "default",
          "buckets": [
            {
              "name": "documents",
              "is_public": false,
              "description": "Room documents; the extraction worker resolves this bucket by its documents tag",
              "tags": [
                "documents",
                "default"
              ]
            }
          ],
          "restrict_reads": true,
          "has_path_shares": true,
          "has_versioning": true,
          "has_audit_log": true,
          "has_content_hash": true,
          "upload_url_expiry_seconds": 600,
          "download_url_expiry_seconds": 1200,
          "default_max_file_size": 1073741824
        }
      ]
    }
  ],
  "agents": [
    {
