{
  "$schema": "https://constructive.io/schemas/blueprint.json",
  "name": "fundraise",
  "display_name": "Fundraise",
  "description": "Agentic CRM + granular Data Room in one blueprint for running a raise: track investors as contacts/companies/deals at org scope, and share diligence documents through per-deal Data Rooms whose files are gated by room membership, capabilities and path shares. The two domains are joined by deals.data_room_id, which is a pointer and never an access grant.",
  "categories": [
    "crm",
    "storage",
    "collaboration"
  ],
  "tags": [
    "fundraising",
    "crm",
    "data-room",
    "diligence",
    "investors",
    "projects"
  ],
  "complexity": "complex",
  "storage": [
    {
      "scope": "org",
      "buckets": [
        {
          "name": "images",
          "is_public": true,
          "tags": [
            "images",
            "default-public"
          ],
          "description": "Public, CDN-servable images referenced from record columns (contacts.avatar, companies.logo)",
          "allowed_mime_types": [
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp",
            "image/svg+xml"
          ]
        },
        {
          "name": "attachments",
          "is_public": false,
          "tags": [
            "attachments",
            "documents",
            "default"
          ],
          "description": "Private files linked to CRM records through the attachments table; tagged documents so the extraction worker can read them"
        }
      ]
    }
  ],
  "tables": [
    {
      "table_name": "contacts",
      "description": "A person. Denormalized primary email/phone live here for fast display and search; the full lists are contact_emails / contact_phones. avatar is an image reference into the org images bucket.",
      "nodes": [
        "DataId",
        "DataTimestamps",
        {
          "$type": "DataOwnershipInEntity",
          "data": {
            "entity_field": "entity_id"
          }
        },
        {
          "$type": "DataFileRef",
          "data": {
            "field": "avatar",
            "storage": {
              "scope": "org"
            },
            "bucket": "images"
          }
        },
        {
          "$type": "SearchUnified",
          "data": {
            "full_text_search": {
              "field_name": "search_tsv",
              "source_fields": [
                {
                  "field": "first_name",
                  "weight": "A"
                },
                {
                  "field": "last_name",
                  "weight": "A"
                },
                {
                  "field": "headline",
                  "weight": "B"
                },
                {
                  "field": "bio",
                  "weight": "C"
                }
              ]
            },
            "trgm_fields": [
              "first_name",
              "last_name"
            ],
            "source_fields": [
              "first_name",
              "last_name",
              "headline",
              "bio",
              "location",
              "how_we_met"
            ],
            "embedding": {
              "field_name": "embedding",
              "chunks": {
                "chunk_size": 1000,
                "chunk_overlap": 200,
                "chunk_strategy": "paragraph"
              }
            }
          }
        }
      ],
      "fields": [
        {
          "name": "first_name",
          "type": {
            "name": "text"
          },
          "is_required": true
        },
        {
          "name": "last_name",
          "type": {
            "name": "text"
          }
        },
        {
          "name": "email",
          "type": {
            "name": "text"
          }
        },
        {
          "name": "phone",
          "type": {
            "name": "text"
          }
        },
        {
          "name": "headline",
          "type": {
            "name": "text"
          }
        },
        {
          "name": "bio",
          "type": {
            "name": "text"
          }
        },
        {
          "name": "location",
          "type": {
            "name": "text"
          }
        },
        {
          "name": "birthday",
          "type": {
            "name": "date"
          }
        },
        {
          "name": "how_we_met",
          "type": {
            "name": "text"
          }
        },
        {
          "name": "relationship_types",
          "type": {
            "name": "text"
          },
          "array_dimensions": 1
        },
        {
          "name": "avatar",
          "type": {
            "name": "image"
          },
          "description": "Profile photo: a projection of an org_files row in the public images bucket (id, key, mime, bucket_id, size, filename)."
        }
      ],
      "grants": [
        {
          "roles": [
            "authenticated"
          ],
          "privileges": [
            [
              "select",
              "*"
            ],
            [
              "insert",
              "*"
            ],
            [
              "update",
              "*"
            ],
            [
              "delete",
              "*"
            ]
          ]
        }
      ],
      "use_rls": true,
      "policies": [
        {
          "$type": "AuthzEntityMembership",
          "privileges": [
            "select",
            "insert",
            "update",
            "delete"
          ],
          "data": {
            "entity_field": "entity_id",
            "entity_type": "org"
          },
          "permissive": true
        }
      ],
      "indexes": []
    },
    {
