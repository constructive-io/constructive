#!/usr/bin/env node

const args = process.argv.slice(2);
const promptIndex = args.indexOf('resume');
const sessionId = promptIndex >= 0 ? args[promptIndex + 1] : '01a0a38b-442f-7f91-a250-72f305c839f7';
const prompt = promptIndex >= 0 ? args[promptIndex + 2] : args[args.length - 1];
const emit = value => process.stdout.write(`${JSON.stringify(value)}\n`);

emit({ type: 'thread.started', thread_id: sessionId });
emit({
  type: 'item.completed',
  item: { id: 'msg_fake', type: 'agent_message', text: `echo:${prompt}` }
});
emit({ type: 'turn.completed', usage: {} });
